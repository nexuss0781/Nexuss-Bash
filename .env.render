# ============================================
# RENDER ENVIRONMENT VARIABLES FOR nexuss-api
# ============================================
# 
# HOW TO USE:
# 1. Copy this file to Render Dashboard → Environment
# 2. For SECRETS: use "Add Secret" button (values hidden)
# 3. For CONFIG: use "Add Environment Variable" (values visible)
# 4. Generate API_KEY: openssl rand -hex 32
#
# ============================================

# ============================================
# SECRETS (use "Add Secret" in Render Dashboard)
# ============================================

# Bootstrap admin API key - GENERATE THIS ONCE
# Run: openssl rand -hex 32
API_KEY=classicboy0781

# Paradox/Parad credentials (already have these)
PARADOX_TOKEN=pk_eVMpPuoZ_w4RXn0H-sCa4dKsy-tC_S5QyShGYyimmmg
PARADOX_PASSPHRASE=0QEALy10Qa3mtaymclKgkg9Z8RlpiHrad3yUgpDfR6s

# ============================================
# PLAIN CONFIG (use "Add Environment Variable")
# ============================================

# Paradox Gateway
PARADOX_GATEWAY=https://paradox-db.onrender.com/v1
PARADOX_PULL_ON_STARTUP=true
PARADOX_STORAGE_CHANNEL=-1004470017903
PARADOX_PROJECT=nexuss
PARADOX_DB=nexuss-bash
PARADOX_AUTO_SYNC=true

# CORS
CORS_ORIGINS=*

# Resource / cleanup tuning - RELAXED for AI/research
CLEANUP_INTERVAL_MIN=60
CLEANUP_TTL_HOURS=24
IDLE_SESSION_TIMEOUT_MIN=120
MEMORY_LIMIT_MB=8192

# Execution limits - VERY RELAXED for AI/research workloads
EXEC_TIMEOUT_SEC=3600
JOB_TIMEOUT_SEC=7200
MAX_OUTPUT_BYTES=104857600

# Rate limits - VERY HIGH for research flexibility
SESSION_CREATE_RATE=1000
JOB_SUBMIT_RATE=1000
EXEC_RATE=10000

# Resource thresholds - HIGH for AI workloads
CPU_LIMIT_PCT=95
DISK_LIMIT_MB=50000
PACKAGE_INSTALL_RATE=100
MAX_UPLOAD_MB=500
MAX_PIPELINE_STEPS=100

# Features
ENABLE_BWRAP=false
PARADOX_OUTPUT_CAP_KB=102400

# Server
PORT=3000
NODE_ENV=production