{
  "name": "nexinals",
  "version": "2.0.0",
  "description": "TypeScript/JavaScript client for Nexuss Bash remote execution API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run clean && npm run build:cjs && npm run build:esm && node scripts/postbuild.mjs",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.cjs.json --noEmit",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nexuss",
    "bash",
    "remote",
    "execution",
    "terminal",
    "api",
    "cli"
  ],
  "author": "Nexuss",
  "license": "MIT",
  "homepage": "https://github.com/nexuss0781/Nexuss-Bash",
  "repository": {
    "type": "git",
    "url": "https://github.com/nexuss0781/Nexuss-Bash.git",
    "directory": "ts-client"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
